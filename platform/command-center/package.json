{
  "name": "@nexora/module-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexora backend module: the generic Command Center engine (S24 Phase 2) — role-aware workspaces resolved from the Phase 1 Domain → Role catalog, rendered by one engine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexora/contracts": "workspace:*",
    "@nexora/shared": "workspace:*"
  },
  "devDependencies": {
    "@nexora/module-domains": "workspace:*",
    "@types/node": "^20.0.0",
    "vitest": "^2.1.0"
  }
}
