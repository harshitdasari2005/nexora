# Nexora — local development environment template
# Copy to .env and adjust. Referenced by infrastructure/compose/docker-compose.yml
# and loaded by apps/api (see apps/api/README.md).
#
# `.env` is gitignored — commit only this template.

# --- PostgreSQL ---
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password

# --- Redis ---
REDIS_PASSWORD=nexora_dev_redis

# --- MinIO (object storage; S3-compatible) ---
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=nexora_dev_minio

# --- Keycloak (OIDC identity — nexora realm imported at startup) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=nexora_dev_keycloak

# --- API (@nexora/app-api) ---
# Required. Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above and
# the postgres port mapped in infrastructure/compose/docker-compose.yml
# (host 5433 -> container 5432; 5433 avoids shadowing by a local Postgres).
DATABASE_URL=postgres://nexora:nexora_dev_password@localhost:5433/nexora
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_AUTO_MIGRATE=true
WEB_ORIGIN=http://localhost:5173
SESSION_MAX_AGE_SECONDS=28800
COOKIE_NAME=nexora_session
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Must match the Keycloak realm issuer and the client in realm-nexora.json.
OIDC_ISSUER_URL=http://localhost:8080/realms/nexora
OIDC_CLIENT_ID=nexora-web
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# --- Enterprise AI Runtime (Groq provider) ---
# Optional. When GROQ_API_KEY is set, the AI narrates responses with Groq
# (llama-3.3-70b-versatile); otherwise deterministic narration is used.
# Get a key at https://console.groq.com.
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- Web (@nexora/app-web) ---
# Vite dev server (port 5173) proxies /api to the API (apps/web/vite.config.ts).
