# Nexora — local development environment template
# Copy to .env and adjust. Referenced by infrastructure/compose/docker-compose.yml
# and loaded by apps/api (see apps/api/README.md).
#
# `.env` is gitignored — commit only this template.

# --- PostgreSQL ---
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password

# --- Redis ---
REDIS_PASSWORD=nexora_dev_redis

# --- MinIO (object storage; S3-compatible) ---
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=nexora_dev_minio

# --- Keycloak (OIDC identity — nexora realm imported at startup) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=nexora_dev_keycloak

# --- API (@nexora/app-api) ---
# Required. Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above and
# the postgres port mapped in infrastructure/compose/docker-compose.yml
# (host 5433 -> container 5432; 5433 avoids shadowing by a local Postgres).
DATABASE_URL=postgres://nexora:nexora_dev_password@localhost:5433/nexora
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_AUTO_MIGRATE=true
WEB_ORIGIN=http://localhost:5173
SESSION_MAX_AGE_SECONDS=28800
# Base name of the session cookie. When the cookie is Secure (production / COOKIE_SECURE=true)
# the emitted name is `__Host-<COOKIE_NAME>` (AUTH-007); plain-HTTP dev keeps `<COOKIE_NAME>`.
COOKIE_NAME=nexora_session
COOKIE_SAME_SITE=lax
# Defaults to true when NODE_ENV=production; an explicit value always wins.
# `false` is for plain-HTTP local development only.
COOKIE_SECURE=false
# Must match the Keycloak realm issuer and the client in realm-nexora.json.
OIDC_ISSUER_URL=http://localhost:8080/realms/nexora
OIDC_CLIENT_ID=nexora-web
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# --- S3 / MinIO (durable document content; S17) ---
# Optional. When S3_ENDPOINT is set, document binaries are stored durably in
# MinIO (infrastructure/compose/docker-compose.yml). When unset the API falls
# back to in-memory document storage (local dev without object storage).
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=nexora
S3_SECRET_KEY=nexora_dev_minio
S3_BUCKET=nexora-documents

# --- Integrations (S20/S21) ---
# REQUIRED. The shared secret that signs/verifies the inbound email action
# endpoint (HMAC-SHA256 over the raw body). Generate a strong random value
# (e.g. `openssl rand -hex 32`); a deployment that omits it fails fast
# rather than running with a known default secret.
INTEGRATIONS_INBOUND_SECRET=replace-with-a-long-random-hex-string

# --- Enterprise AI Runtime (narration provider) ---
# Planning, tool selection, permission filtering, and approval gating are
# ALWAYS deterministic code — no model decides what the AI does. A provider
# is used only to phrase the final answer, so AI_PROVIDER is purely a
# data-residency decision about that one call.
#
#   none  — no provider. Deterministic narration; nothing leaves the process.
#   local — a model you host (Ollama, vLLM, LM Studio, TGI). Prompt content —
#           the user's question plus the executed step results, which carry
#           real tenant records — stays inside your own network.
#   groq  — the hosted Groq API. That same prompt content transits a third
#           party; use only where your data policy permits it.
#
# Defaults to `none` (or `groq` when a legacy GROQ_API_KEY is set, for
# backward compatibility). A misconfigured provider fails fast at boot.
AI_PROVIDER=none

# Self-hosted (AI_PROVIDER=local). AI_BASE_URL is required and must be an
# OpenAI-compatible endpoint. Examples:
#   Ollama     http://localhost:11434/v1   (after: ollama pull llama3)
#   vLLM       http://gpu-host.internal:8000/v1
#   LM Studio  http://localhost:1234/v1
# AI_API_KEY is only needed if that endpoint sits behind an auth gateway.
AI_BASE_URL=
AI_API_KEY=

# Hosted Groq (AI_PROVIDER=groq). Get a key at https://console.groq.com.
GROQ_API_KEY=

# The model id served by the selected provider. Match it to the provider:
#   groq   openai/gpt-oss-120b (see https://console.groq.com/docs/models for what your key can use)
#   local  qwen2.5(-coder) / phi3 / mistral / llama3 (whatever you have pulled)
# Narration is always grounded (it can only restate what the tools returned),
# but COMPLETENESS of a multi-fact answer scales with the model's
# instruction-following: qwen2.5, phi3 and the large Groq model report every
# flagged item and preserve "blocked" / "nothing-else" boundaries; llama3:8b
# tends to give a correct but partial answer. Pick accordingly.
AI_MODEL=openai/gpt-oss-120b

# --- Web (@nexora/app-web) ---
# Vite dev server (port 5173) proxies /api to the API (apps/web/vite.config.ts).

# --- Demo mode (final demo experience) --------------------------------------
# Explicit opt-in. When true, the API seeds ONE deterministic demo organization
# (Lumen Capital (Demo)) at boot and exposes /api/demo/* (persona sign-in from
# a fixed allowlist of seeded users, and a reset of that organization only).
# When unset/false these routes do not exist (404) and sign-in is unchanged.
# Demo sign-in is UNAUTHENTICATED: with NODE_ENV=production the API refuses to
# start unless NEXORA_DEMO_ALLOW_IN_PRODUCTION=true is also set (a deliberately
# public demo deployment only).
NEXORA_DEMO_MODE=false

# --- Production posture (AUTH-003) -------------------------------------------
# A deployment is treated as production when NODE_ENV=production OR its
# WEB_ORIGIN / OIDC_REDIRECT_URI is not a loopback address (localhost, 127.0.0.1,
# ::1). On such a deployment: session cookies are Secure by default, demo mode
# needs NEXORA_DEMO_ALLOW_IN_PRODUCTION=true, and COOKIE_SECURE=false needs
# NEXORA_ALLOW_INSECURE_COOKIES=true — otherwise the API refuses to start.
# Local HTTP development (the loopback defaults above) is unaffected.
# NEXORA_ALLOW_INSECURE_COOKIES=false
#
# Browser-origin guard (AUTH-008): state-changing browser requests must come from
# WEB_ORIGIN (or the API's own origin, from OIDC_REDIRECT_URI). If the web app is
# served from another origin in development (e.g. a different Vite port), set
# WEB_ORIGIN to match it.
