{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "description": "Work. Orchestrated by AI. — AI-native enterprise operating system monorepo.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:infra": "docker compose -f infrastructure/compose/docker-compose.yml up -d",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:local:down": "bash scripts/dev-local-down.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "perf:load": "node tests/performance/load-test.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "gen:module": "node scripts/gen-module.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:api": "pnpm --filter @nexora/app-api dev",
    "dev:web": "pnpm --filter @nexora/app-web dev"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
