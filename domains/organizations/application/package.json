  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexora/contracts": "workspace:*",
    "@nexora/domain-organizations": "workspace:*",
    "@nexora/shared": "workspace:*"
  },
