{
  "name": "@nexora/persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexora PostgreSQL persistence layer — Drizzle schema, migrations, and repository implementations behind the domain repository interfaces (PERSISTENCE.md).",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/src/schema/index.d.ts",
      "default": "./dist/src/schema/index.js"
    },
    "./repositories": {
      "types": "./dist/src/repositories/index.d.ts",
      "default": "./dist/src/repositories/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nexora/contracts": "workspace:*",
    "@nexora/domain-documents": "workspace:*",
    "@nexora/domain-hr": "workspace:*",
    "@nexora/domain-identity": "workspace:*",
    "@nexora/domain-knowledge": "workspace:*",
    "@nexora/domain-organizations": "workspace:*",
    "@nexora/domain-projects": "workspace:*",
    "@nexora/domain-workspaces": "workspace:*",
    "@nexora/module-calendar": "workspace:*",
    "@nexora/module-integrations": "workspace:*",
    "@nexora/module-measurements": "workspace:*",
    "@nexora/module-notifications": "workspace:*",
    "@nexora/module-search": "workspace:*",
    "@nexora/module-workflow": "workspace:*",
    "@nexora/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "vitest": "^2.1.0"
  }
}
